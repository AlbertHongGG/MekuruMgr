# ==========================================
# ComicMgr Environment Variables Example
# ==========================================

# ------------------------------------------
# Provider: ComicWifi
# ------------------------------------------
# All configuration keys for the ComicWifi provider MUST be prefixed with COMICWIFI_
COMICWIFI_USER_AGENT=ktor-client
COMICWIFI_DEVICE_ID=your_device_id_here
COMICWIFI_APP_VERSION=1.1.1
COMICWIFI_APP_VERSION_CODE=111
COMICWIFI_CHANNEL_NO=3
COMICWIFI_APP_CHANNEL=3
COMICWIFI_APP_ID=6
COMICWIFI_OS_VERSION=13
COMICWIFI_DEVICE_MODEL=SM-A326BR
COMICWIFI_DEVICE_BRAND=samsung
COMICWIFI_DEVICE_MAKE=samsung
COMICWIFI_SCREEN_WIDTH=720
COMICWIFI_SCREEN_HEIGHT=1445
COMICWIFI_OS_TYPE=1
COMICWIFI_NETWORK_TYPE=0
COMICWIFI_LANGUAGE=zh
COMICWIFI_DEVICE_LANGUAGE=zh
COMICWIFI_TIME_ZONE=GMT+08:00
COMICWIFI_LOWER_FLOW=No
COMICWIFI_IMEI=
COMICWIFI_MAC=
COMICWIFI_OAID=
COMICWIFI_USERID=-1
COMICWIFI_TOKEN=
COMICWIFI_ISVPN=
COMICWIFI_LANGUAGECODE=
